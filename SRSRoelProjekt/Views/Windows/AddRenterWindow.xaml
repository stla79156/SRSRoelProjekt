<Window x:Class="SRSRoelProjekt.Views.AddRenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SRSRoelProjekt.Views"
        mc:Ignorable="d"
        Title="AddRenterWindow" Height="400" Width="400"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <StackPanel Margin="20">

            <TextBlock Text="For- og Efternavn:" />
            <TextBox Text="{Binding Name}" />
            <TextBlock Text=" "/>
            
            <TextBlock Text="Email:" Margin="0,10,0,0"/>
            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="{Binding EmailError}" Foreground="Red" />
            
            <TextBlock Text="Telefonnummer:" Margin="0,10,0,0"/>
            <TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="{Binding PhoneError}" Foreground="Red" />

            <TextBlock Text="Brugernavn:" Margin="0,10,0,0"/>
            <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="{Binding UsernameError}" Foreground="Red" />

            <Button Content="Tilføj lejer"
                Margin="0,20,0,0"
                Command="{Binding AddRenterCommand}" />
        </StackPanel>


    </Grid>
</Window>
