<Window x:Class="SRSRoelProjekt.Views.Windows.RackInfoWindow"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shelf Information"
        Height="250"
        Width="350"
        ResizeMode="NoResize">

    <StackPanel Margin="20">

        <TextBlock x:Name="ShelfNumberText"
                   FontSize="16"
                   FontWeight="Bold"
                   Margin="0,0,0,10"/>

        <TextBlock x:Name="RenterText"
                   Margin="0,5"/>

        <TextBlock x:Name="StatusText"
                   Margin="0,5"/>

        <TextBlock x:Name="EndDateText"
                   Margin="0,5"/>

        <TextBlock x:Name="AvailableFromText"
                   Margin="0,5"/>

        <Button Content="Luk"
                Width="100"
                Margin="0,20,0,0"
                HorizontalAlignment="Center"
                Click="Close_Click"/>

    </StackPanel>
</Window>
