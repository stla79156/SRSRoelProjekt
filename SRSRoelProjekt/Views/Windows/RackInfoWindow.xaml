<Window x:Class="SRSRoelProjekt.Views.Windows.RackInfoWindow"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shelf Information"
        Height="300"
        Width="350"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <StackPanel Margin="20">

        <TextBlock Text="{Binding RackNumber}"
           FontSize="16"
           FontWeight="Bold"
           Margin="0,0,0,10"/>

        <TextBlock Text="{Binding RenterName}"
           Margin="0,5"/>

        <TextBlock Text="{Binding Status}"
           Margin="0,5"/>
        
        <TextBlock Text="{Binding Type}"
           Margin="0,5"/>

        <TextBlock Text="{Binding EndDate}"
           Margin="0,5"/>

        <TextBlock Text="{Binding AvailableFrom}"
           Margin="0,5"/>

        <Button Content="Luk"
                Width="100"
                Margin="0,20,0,0"
                HorizontalAlignment="Center"
                Click="Close_Click"/>

    </StackPanel>
</Window>
