<Window x:Class="SRSRoelProjekt.Views.Windows.RenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SRSRoelProjekt.Views.Windows"
        xmlns:views="clr-namespace:SRSRoelProjekt.Views.UserControls" 
        mc:Ignorable="d"
        Title="RenterWindow" Height="450" Width="800"
        WindowStartupLocation="CenterScreen">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="15*"/>
            <RowDefinition Height="85*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#2C3E50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>  
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            
            <TextBlock Grid.Column="0" Text="{Binding WelcomeText}"
                FontSize="24" FontWeight="Bold" Foreground="White"
                VerticalAlignment="Center" HorizontalAlignment="Left"
                Margin="20,0,0,0" FontFamily="Cambria"/>

            <Button Grid.Column="1" Content="Log af" Command="{Binding LogOutCommand}" 
                    Foreground="#2C3E50" FontWeight="Bold" FontSize="18"  Margin="5" 
                    MinWidth="100" MinHeight="30" MaxHeight="60" MaxWidth="200" 
                    Background=" Lightblue" BorderBrush="SkyBlue" FontFamily="Cambria"/>

        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MaxWidth="550"/>
                <ColumnDefinition Width="6*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Row="1"
                Grid.Column="0"
                Background="#F5F5F5" />
            
            <views:ProductControl
                Grid.Column="0"
                Grid.Row="1"
                MaxWidth="500" 
                />
            <DataGrid Grid.Row="1"
          Grid.Column="1"
          Margin="10"
          ItemsSource="{Binding Products}"
          SelectedItem="{Binding SelectedProduct}"
          AutoGenerateColumns="False"
          IsReadOnly="True">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Produktnavn"
                            Binding="{Binding ProductName}"
                            Width="*" />

                    <DataGridTextColumn Header="Beskrivelse"
                            Binding="{Binding ProductDescription}"
                            Width="2*" />

                    <DataGridTextColumn Header="Pris"
                            Binding="{Binding Price}"
                            Width="100" />

                </DataGrid.Columns>

            </DataGrid>
        </Grid>


    </Grid>
</Window>
