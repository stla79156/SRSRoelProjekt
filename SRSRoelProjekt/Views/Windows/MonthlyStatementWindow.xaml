<Window x:Class="SRSRoelProjekt.Views.Windows.MonthlyStatementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Månedsopgørelse"
        Height="700"
        Width="1000"
        WindowStartupLocation="CenterScreen">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->

        <Border Grid.Row="0"
                Background="#2C3E50">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Månedsopgørelse"
                           FontWeight="Bold"
                           Foreground="White"
                           FontSize="24"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>

                <TextBlock Grid.Column="1"
                           Text="{Binding CurrentDate}"
                           FontWeight="Bold"
                           Foreground="White"
                           FontSize="18"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>

                <ComboBox Grid.Column="2"
                          Margin="10"
                          ItemsSource="{Binding Months}"
                          DisplayMemberPath="MonthName"
                          SelectedItem="{Binding SelectedMonth}" />

            </Grid>

        </Border>

        <!-- RENTER STATEMENTS -->

        <ScrollViewer Grid.Row="1"
                      Margin="10"
                      VerticalScrollBarVisibility="Auto">

            <ItemsControl ItemsSource="{Binding Statements}">

                <ItemsControl.ItemTemplate>

                    <DataTemplate>

                        <Border BorderBrush="Black"
                                BorderThickness="1"
                                Margin="5"
                                Padding="10">

                            <StackPanel>

                                <TextBlock Text="{Binding RenterName}"
                                           FontWeight="Bold"
                                           FontSize="18"/>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,5">

                                    <TextBlock Text="Antal reoler: "
                                               FontWeight="Bold"/>

                                    <TextBlock Text="{Binding RackCount}"/>

                                </StackPanel>

                                <Separator Margin="0,5"/>

                                <!-- Product Header -->

                                <Grid Margin="0,5">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="Produktnavn"
                                               FontWeight="Bold"/>

                                    <TextBlock Grid.Column="1"
                                               Text="Dato Solgt"
                                               FontWeight="Bold"/>

                                    <TextBlock Grid.Column="2"
                                               Text="Pris"
                                               FontWeight="Bold"/>

                                </Grid>

                                <!-- Product List -->

                                <ItemsControl ItemsSource="{Binding Products}">

                                    <ItemsControl.ItemTemplate>

                                        <DataTemplate>

                                            <Grid Margin="0,2">

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="3*"/>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="1*"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding ProductName}"/>

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding SoldDate,
                                                           StringFormat=dd-MM-yyyy}"/>

                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding Price,
                                                           StringFormat={}{0:N2} kr.}"/>

                                            </Grid>

                                        </DataTemplate>

                                    </ItemsControl.ItemTemplate>

                                </ItemsControl>

                                <Separator Margin="0,10"/>

                                <!-- Totals -->

                                <StackPanel HorizontalAlignment="Right">

                                    <StackPanel Orientation="Horizontal">

                                        <TextBlock Text="Total salg: "
                                                   FontWeight="Bold"/>

                                        <TextBlock Text="{Binding TotalSales,
                                                          StringFormat={}{0:N2} kr.}"/>

                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal">

                                        <TextBlock Text="Kommission (10%): "
                                                   FontWeight="Bold"/>

                                        <TextBlock Text="{Binding Commission,
                                                          StringFormat={}{0:N2} kr.}"/>

                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal">

                                        <TextBlock Text="Reol beløb: "
                                                   FontWeight="Bold"/>

                                        <TextBlock Text="{Binding RackAmount,
                                                          StringFormat={}{0:N2} kr.}"/>

                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal">

                                        <TextBlock Text="Saldo: "
                                                   FontWeight="Bold"/>

                                        <TextBlock Text="{Binding FinalAmount,
                                                          StringFormat={}{0:N2} kr.}"/>

                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal">

                                        <TextBlock Text="Bogført: "
                                                   FontWeight="Bold"
                                                   Margin="0,0,5,0"/>           

                                        <Ellipse Width="15"
                                                 Height="15">

                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">

                                                    <Setter Property="Fill"
                                                            Value="Red"/>

                                                    <Style.Triggers>

                                                        <DataTrigger Binding="{Binding IsPosted}"
                                                                     Value="True">

                                                            <Setter Property="Fill"
                                                                    Value="LimeGreen"/>

                                                        </DataTrigger>

                                                    </Style.Triggers>

                                                </Style>
                                            </Ellipse.Style>

                                        </Ellipse>

                                    </StackPanel>
                                </StackPanel>

                            </StackPanel>

                        </Border>

                    </DataTemplate>

                </ItemsControl.ItemTemplate>

            </ItemsControl>

        </ScrollViewer>

        <!-- MONTH SUMMARY + BUTTON -->

        <Border Grid.Row="2"
                BorderBrush="Black"
                BorderThickness="1"
                Margin="10"
                Padding="10">

            <StackPanel>

                <TextBlock Text="Månedens oversigt"
                           FontWeight="Bold"
                           FontSize="18"
                           Margin="0,0,0,10"/>

                <TextBlock Text="{Binding TotalMonthlySales,
                                  StringFormat=Samlet salg: {0:N2} kr.}"/>

                <TextBlock Text="{Binding TotalMonthlyCommission,
                                  StringFormat=Samlet kommission: {0:N2} kr.}"/>

                <TextBlock Text="{Binding TotalMonthlyRackRent,
                                  StringFormat=Samlet reolleje: {0:N2} kr.}"/>

                <TextBlock Text="{Binding CompanyMonthlyIncome,
                                  StringFormat=Virksomhedens indtjening: {0:N2} kr.}"
                           FontWeight="Bold"
                           Margin="0,0,0,15"/>

                <Button Content="Bogfør måned"
                        Command="{Binding PostMonthCommand}"
                        Width="150"
                        HorizontalAlignment="Right"/>

            </StackPanel>

        </Border>

    </Grid>

</Window>