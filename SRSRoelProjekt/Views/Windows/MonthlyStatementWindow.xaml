<Window x:Class="SRSRoelProjekt.Views.Windows.MonthlyStatementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MonthlyStatementWindow"
        Height="450"
        Width="800">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2C3E50">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                   Text="Månedsopgørelse"
                   FontWeight="Bold"
                   Foreground="White"
                   FontSize="24"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"/>

                <ComboBox Grid.Column="1"
                  Margin="10"
                  ItemsSource="{Binding Months}"
                  DisplayMemberPath="MonthName"
                  SelectedItem="{Binding SelectedMonth}" />

                <ComboBox Grid.Column="2"
                  Margin="10"
                  ItemsSource="{Binding SortOptions}"
                  DisplayMemberPath="Name"
                  SelectedItem="{Binding SelectedSortOption}" />

            </Grid>

        </Border>
        <Border Grid.Row="1"
        BorderBrush="Black"
        BorderThickness="1"
        Margin="10">

            <StackPanel Margin="10">

                <ItemsControl Grid.Row="1"
              ItemsSource="{Binding Statements}">

                    <ItemsControl.ItemTemplate>

                        <DataTemplate>

                            <Border BorderBrush="Black"
                    BorderThickness="1"
                    Margin="5"
                    Padding="5">

                                <StackPanel>

                                    <TextBlock FontWeight="Bold"
                               Text="{Binding RenterName}" />

                                </StackPanel>

                            </Border>

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>

                <StackPanel Orientation="Horizontal">

                    <TextBlock Text="Antal reoler: "
               FontWeight="Bold"/>

                    <TextBlock Text="{Binding RackCount}" />

                </StackPanel>

                <Separator Margin="0,10"/>

                <Grid Margin="0,5">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
               Text="Produktnavn"
               FontWeight="Bold"/>

                    <TextBlock Grid.Column="1"
               Text="Dato Solgt"
               FontWeight="Bold"/>

                    <TextBlock Grid.Column="2"
               Text="Pris"
               FontWeight="Bold"/>

                </Grid>

                <ItemsControl ItemsSource="{Binding Products}">

                    <ItemsControl.ItemTemplate>

                        <DataTemplate>

                            <Grid Margin="0,2">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                           Text="{Binding ProductName}" />

                                <TextBlock Grid.Column="1"
                           Text="{Binding SoldDate}" />

                                <TextBlock Grid.Column="2"
                           Text="{Binding Price}" />

                            </Grid>

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>

                <TextBlock Text="Total salg: "
               FontWeight="Bold"/>

                    <TextBlock Text="{Binding TotalSales}" />

                    <TextBlock Text=" kr."/>

                </StackPanel>

                <StackPanel Orientation="Horizontal">

                    <TextBlock Text="Kommission: "
               FontWeight="Bold"/>

                    <TextBlock Text="{Binding Commission}" />

                    <TextBlock Text=" kr."/>

                </StackPanel>

                <StackPanel Orientation="Horizontal">

                    <TextBlock Text="Reol beløb: "
               FontWeight="Bold"/>

                    <TextBlock Text="{Binding RackAmount}" />

                    <TextBlock Text=" kr."/>

                </StackPanel>

                <StackPanel Orientation="Horizontal">

                    <TextBlock Text="Saldo: "
               FontWeight="Bold"/>

                    <TextBlock Text="{Binding FinalAmount}" />

                    <TextBlock Text=" kr."/>

                </StackPanel>

            </StackPanel>

        </Border>

    </Grid>

</Window>
    