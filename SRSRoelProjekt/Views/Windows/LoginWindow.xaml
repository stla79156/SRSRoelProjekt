<Window x:Class="SRSRoelProjekt.Views.Windows.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SRSRoelProjekt.Views.Windows"
        mc:Ignorable="d"
        Title="LoginWindow" Height="450" Width="800">
    <Grid>

        <StackPanel>
            
    <TextBlock Text="Login Ind Vindue"
     
    HorizontalAlignment="left" Margin="20,0,0,00"
   FontSize="20"/>



    <TextBlock Text="Indtast brugernavn: "
                 
                HorizontalAlignment="left" Margin="100,80,0,10"
               FontSize="20" FontFamily="Cambria"/>

            <TextBox Text="{Binding UserId, UpdateSourceTrigger=PropertyChanged}" 
             Height="30" Width="200" HorizontalAlignment="Left" 
             Margin="100,0,0,0" Background="Transparent" FontFamily="Cambria" />
    
    
    <Button Content="Log ind"
            Command="{Binding LoginCommand}" 
            Margin="100,20,0,0" Width="100" Height="50" 
            HorizontalAlignment="Left" VerticalAlignment="Center" 
            FontSize="18" Background="LightBlue" 
            Foreground="#2C3E50" BorderBrush="SkyBlue" FontFamily="Cambria"
            />
    
    
    <TextBlock Text="{Binding UserIdError}" 
               Foreground="Red" Margin="0,0,0,10"/>








        </StackPanel>
        
        
        
		
		
    </Grid>
</Window>
