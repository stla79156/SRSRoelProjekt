<Window x:Class="SRSRoelProjekt.Views.Windows.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SRSRoelProjekt.Views.Windows"
        mc:Ignorable="d"
        Title="LoginWindow" Height="450" Width="800">
    <Grid>

        <StackPanel>

            <TextBlock Text="Indtast brugernavn: "
               Margin="100,80,0,10"
               HorizontalAlignment="left"
               FontSize="20"
               FontFamily="Cambria"/>

            <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" 
               Margin="100,0,0,0"
               Height="30"
               Width="600"
               HorizontalAlignment="Left"
               FontSize="18"
               FontFamily="Cambria"
               Background="Transparent" />


            <TextBlock Text="{Binding UsernameError}"
               Margin="100,0,0,0"
               Height="20"
               Width="600"
               HorizontalAlignment="Left"
               Foreground="Red" />


            <Button Content="Log ind"
               Command="{Binding LoginCommand}" 
               Margin="0,20,0,0"
               Width="150"
               Height="50"
               HorizontalAlignment="Center"
               VerticalAlignment="Center" 
               FontSize="18"
               FontWeight="Bold"
               Background="LightBlue" 
               Foreground="#2C3E50"
               BorderBrush="SkyBlue"
               FontFamily="Cambria" />

        </StackPanel>

    </Grid>
</Window>
