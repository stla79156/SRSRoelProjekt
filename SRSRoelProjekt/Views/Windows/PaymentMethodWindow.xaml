<Window x:Class="SRSRoelProjekt.Views.Windows.PaymentMethodWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vælg betalingsmetode"
        Height="200"
        Width="300"
        WindowStartupLocation="CenterScreen">

    <StackPanel VerticalAlignment="Center">

        <TextBlock Text="Vælg betalingsmetode"
                   FontSize="18"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

        <Button Content="MobilePay"
                Command="{Binding MobilePayCommand}"
                Margin="20,5"/>

        <Button Content="Kontant"
                Command="{Binding CashCommand}"
                Margin="20,5"/>

    </StackPanel>

</Window>
