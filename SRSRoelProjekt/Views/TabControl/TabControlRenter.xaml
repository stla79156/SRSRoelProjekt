<Window x:Class="SRSRoelProjekt.Views.TabControl.TabControlRenter"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SRSRoelProjekt.Views.TabControl"
        xmlns:views="clr-namespace:SRSRoelProjekt.Views"
        mc:Ignorable="d"
        Title="TabControlEmployee" Height="800" Width="1200"
        MinWidth="1200"
        MinHeight="750"
        MaxWidth="1568"
        MaxHeight="980"
        SizeChanged="Window_SizeChanged"
        >
    <TabControl>
        <TabControl.Resources>
            <Style TargetType="TabItem">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="Border"
                  Background="GhostWhite"
                  BorderBrush="SteelBlue"
                  BorderThickness="1"
                  Padding="10,5">
                                <ContentPresenter
                  ContentSource="Header"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"/>
                            </Border>

                            <ControlTemplate.Triggers>

                                <Trigger Property="IsMouseOver"
                                          Value="True">

                                    <Setter TargetName="Border"
                                          Property="Background"
                                          Value="LightCyan"/>

                                    <Setter TargetName="Border"
                                          Property="BorderBrush"
                                          Value="DeepSkyBlue"/>

                                </Trigger>

                                <Trigger Property="IsSelected"
                                       Value="True">

                                    <Setter TargetName="Border"
                                          Property="Background"
                                          Value="LightBlue"/>

                                    <Setter TargetName="Border"
                                          Property="BorderBrush"
                                          Value="SkyBlue"/>

                                </Trigger>

                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </TabControl.Resources>

        <TabItem Header="Reol Overblik" FontSize="16">
            <views:RenterView DataContext="{Binding RenterWindowViewModel}"/>
        </TabItem>

        <TabItem Header="Månedsoversigt" FontSize="16">
            <views:MonthlyStatementRenterView DataContext="{Binding MonthlyStatementRenterViewModel}"/>
        </TabItem>

    </TabControl>
</Window>
