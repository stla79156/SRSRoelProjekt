<Window x:Class="SRSRoelProjekt.Views.TabControl.TabControlEmployee"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SRSRoelProjekt.Views.TabControl"
        xmlns:views="clr-namespace:SRSRoelProjekt.Views"
        mc:Ignorable="d"
        Title="TabControlEmployee" Height="800" Width="1200"
        MinWidth="1200"
        MinHeight="750"
        MaxWidth="1568"
        MaxHeight="980"
        SizeChanged="Window_SizeChanged"
        >

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <TabControl Grid.Row="0">
        <TabControl.Resources>
            <Style TargetType="TabItem">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="Border"
                    Background="GhostWhite"
                    BorderBrush="SteelBlue"
                    BorderThickness="1"
                    Padding="10,5">
                                <ContentPresenter
                    ContentSource="Header"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>
                            </Border>

                            <ControlTemplate.Triggers>

                                <Trigger Property="IsMouseOver"
                                            Value="True">

                                    <Setter TargetName="Border"
                                            Property="Background"
                                            Value="LightCyan"/>

                                    <Setter TargetName="Border"
                                            Property="BorderBrush"
                                            Value="DeepSkyBlue"/>

                                </Trigger>

                                <Trigger Property="IsSelected"
                                         Value="True">

                                    <Setter TargetName="Border"
                                            Property="Background"
                                            Value="LightBlue"/>

                                    <Setter TargetName="Border"
                                            Property="BorderBrush"
                                            Value="SkyBlue"/>

                                </Trigger>

                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </TabControl.Resources>
       
       <TabItem Header="Reol Overblik" FontSize="16">
           <views:MainView DataContext="{Binding MainViewModel}"/>
       </TabItem>

        <TabItem Header="Kasse" FontSize="16">
            <views:RegisterView DataContext="{Binding RegisterViewModel}"/>
        </TabItem>

        <TabItem Header="Månedsopgørelse" FontSize="16">
            <views:MonthlyStatementView DataContext="{Binding MonthlyStatementViewModel}"/>
        </TabItem>

        <TabItem Header="MedarbejderOversigt" FontSize="16">
            <views:AdministratorView DataContext="{Binding AdministratorViewModel}"/>
        </TabItem>
    </TabControl>
        <Button Grid.Row="0" Content="Log af" 
        Command="{Binding LogOutCommand}" 
        Foreground="#2C3E50" FontWeight="Bold" 
        FontSize="18"  Margin="5" MinWidth="150" 
        MinHeight="30" MaxHeight="60" MaxWidth="200" 
        HorizontalAlignment="Right"
        VerticalAlignment="Top"
        Background=" Lightblue" BorderBrush="SkyBlue" 
        FontFamily="Cambria"/>

        <Image Grid.Row="0" Source="/Images/Logo.png" 
       Panel.ZIndex="100"
       Width="150" Height="30"
       HorizontalAlignment="Center" VerticalAlignment="Top" Margin="5"/>

    </Grid>
</Window>
