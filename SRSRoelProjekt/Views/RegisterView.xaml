<UserControl x:Class="SRSRoelProjekt.Views.RegisterView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SRSRoelProjekt.Views.Windows"
        mc:Ignorable="d"
        d:DesignHeight="450" d:DesignWidth="800">

    <!-- Register Window Content -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="15*"/>
            <RowDefinition Height="85*"/>
            
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Background="#2C3E50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*"/>
                <ColumnDefinition Width="4*"/>
            </Grid.ColumnDefinitions>
            
            <TextBlock Grid.Column="0" Text="Kasse Terminal" FontFamily="Cambria" FontWeight="Bold" Foreground="White" FontSize="24" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="Kurv" FontFamily="Cambria" FontWeight="Bold" Foreground="White" FontSize="24" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*"/>
                <ColumnDefinition Width="4*"/>
            </Grid.ColumnDefinitions>

            <!-- Kasse Terminal -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="20*"/>
                    <RowDefinition Height="15*"/>
                    <RowDefinition Height="25*"/>
                    <RowDefinition Height="10*"/>
                    <RowDefinition Height="10*"/>
                    <RowDefinition Height="20*"/>

                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Background="LightGray" BorderThickness="1"/>


                <!-- Indtast Produktnummer -->
                <TextBlock Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2" FontSize="16" FontFamily="Cambria" Text="Indtast Produktnummer:" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,30"/>
                <TextBox Grid.Column="0" Grid.Row="0" Width="100" Grid.ColumnSpan="2" Text="{Binding ProductNumber, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,20,70,0"/>
                <Button Grid.Column="0" Grid.Row="0" Command="{Binding SearchProductCommand}" Width="50" Grid.ColumnSpan="2" Content="Søg" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="100,20,0,0"/>

                <!-- Vis ProduktNavn -->
                <TextBlock Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2" FontSize="14" FontFamily="Cambria" Text="Produkt Navn" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                <TextBox Grid.Column="0" Grid.Row="1" Width="400" Height="25" FontSize="12" FontFamily="Cambria" Text="{Binding ProductName, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" Grid.ColumnSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,15,0,0"/>

                <!-- Vis ProduktBeskrivelse -->
                <TextBlock Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="2" FontSize="14" FontFamily="Cambria" Text="Produkt Beskrivelse" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                <TextBox Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="2" FontSize="12" FontFamily="Cambria" Width="400" Height="50" VerticalAlignment="Center" HorizontalAlignment="Center" Text="{Binding ProductDescription, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" TextWrapping="Wrap" Margin="0,15,0,0"/>

                <!-- Vis Pris -->
                <TextBlock Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" Width="160" Grid.Row="3" FontSize="14" FontFamily="Cambria" Text="Pris" TextAlignment="Left" />
                <TextBox Grid.Column="1" Grid.Row="3" FontSize="12" FontFamily="Cambria" Width="160" Height="30" Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True"/>

                <!-- Vis Reolnummer -->
                <TextBlock Grid.Column="0" Grid.Row="4" VerticalAlignment="Center" HorizontalAlignment="Center" Width="160" Text="Reolnummer" FontSize="14" FontFamily="Cambria" TextAlignment="Left"/>
                <TextBox Grid.Column="1" Grid.Row="4" FontSize="12" Width="160" Height="30" FontFamily="Cambria" Text="{Binding RackNumber, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True"/>

                <!-- Handling Buttons -->
                <Button Grid.Column="0" Grid.Row="5" FontFamily="Cambria" Content="Ryd Valg" Command="{Binding ClearSelectedProductCommand}" Width="160" Height="40" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <Button Grid.Column="1" Grid.Row="5" FontFamily="Cambria" Content="Tilføj til Kurv" Command="{Binding AddProductToCartCommand}" Width="160" Height="40" VerticalAlignment="Center" HorizontalAlignment="Center" />
            </Grid>

            <!-- Kurv -->
            <Grid Grid.Column="1" Background="#F5F5F5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="70*"/>
                    <RowDefinition Height="10*"/>
                    <RowDefinition Height="20*"/>
                </Grid.RowDefinitions>

                <DataGrid Grid.Row="0"
                    Grid.Column="1"
                    Margin="10"
                    ItemsSource="{Binding ShoppingCartItems}"
                    SelectedItem="{Binding SelectedShoppingCartItem}"
                    AutoGenerateColumns="False"
                    IsReadOnly="True">  

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Produktnavn"
                                            FontFamily="Cambria"
                            Binding="{Binding Product.ProductName}"
                            Width="*" />

                        <DataGridTextColumn Header="Pris"
                                            FontFamily="Cambria"
                            Binding="{Binding Product.Price}"
                            Width="100" />

                    </DataGrid.Columns>

                </DataGrid>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="7*"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Total:" FontSize="14" 
                               FontFamily="Cambria" HorizontalAlignment="Right" 
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding TotalPrice, StringFormat={}{0:N2} Kr.}" 
                               FontSize="14" FontFamily="Cambria" HorizontalAlignment="Right" 
                               VerticalAlignment="Center" Margin="10"/>
                </Grid>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="Fjern Valgt Produkt" 
                            Command="{Binding RemoveProductFromCartCommand}" 
                            MinWidth="100" Height="40" VerticalAlignment="Center" 
                            HorizontalAlignment="Center" Margin="5"
                            FontFamily="Cambria"/>
                    
                    <Button Grid.Column="1" Content="Betal"
                            Command="{Binding CheckoutCommand}"
                            MinWidth="100" Height="40" VerticalAlignment="Center"
                            HorizontalAlignment="Center" Margin="5"
                            FontFamily="Cambria"
                            Background="PaleGreen"/>

                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
