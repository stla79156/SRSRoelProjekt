<UserControl x:Class="SRSRoelProjekt.Views.MonthlyStatementRenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1000">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->

        <Border Grid.Row="0"
                Background="#2C3E50">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40*"/>
                    <ColumnDefinition Width="30*"/>
                    <ColumnDefinition Width="30*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Min månedsoversigt"
                           FontWeight="Bold"
                           Foreground="White"
                           FontSize="24"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>

                <TextBlock Grid.Column="1"
                           Text="{Binding CurrentDate}"
                           FontWeight="Bold"
                           Foreground="White"
                           FontSize="18"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>

                <ComboBox Grid.Column="2"
                          Margin="10"
                          ItemsSource="{Binding Months}"
                          DisplayMemberPath="MonthName"
                          SelectedItem="{Binding SelectedMonth}"/>

            </Grid>

        </Border>

        <!-- LEJERS OPGØRELSE -->

        <ScrollViewer Grid.Row="1"
                      Margin="10"
                      VerticalScrollBarVisibility="Auto">

            <Border BorderBrush="Black"
                    BorderThickness="1"
                    Padding="10">

                <StackPanel>

                    <TextBlock Text="{Binding Statement.RenterName}"
                               FontWeight="Bold"
                               FontSize="18"/>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,5">

                        <TextBlock Text="Antal reoler: "
                                   FontWeight="Bold"/>

                        <TextBlock Text="{Binding Statement.RackCount}"/>

                    </StackPanel>

                    <Separator Margin="0,5"/>

                    <!-- PRODUKT OVERSKRIFTER -->

                    <Grid Margin="0,5">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Produktnavn"
                                   FontWeight="Bold"/>

                        <TextBlock Grid.Column="1"
                                   Text="Dato solgt"
                                   FontWeight="Bold"/>

                        <TextBlock Grid.Column="2"
                                   Text="Pris"
                                   FontWeight="Bold"/>

                    </Grid>

                    <!-- PRODUKTLISTE -->

                    <ItemsControl ItemsSource="{Binding Statement.Products}">

                        <ItemsControl.ItemTemplate>

                            <DataTemplate>

                                <Grid Margin="0,2">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding ProductName}"/>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding SoldDate,
                                               StringFormat=dd-MM-yyyy}"/>

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Price,
                                               StringFormat={}{0:N2} kr.}"/>

                                </Grid>

                            </DataTemplate>

                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                    <Separator Margin="0,10"/>

                    <!-- TOTALER -->

                    <StackPanel HorizontalAlignment="Right">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="Total salg: "
                                       FontWeight="Bold"/>

                            <TextBlock Text="{Binding Statement.TotalSales,
                                              StringFormat={}{0:N2} kr.}"/>

                        </StackPanel>

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="Kommission (10%): "
                                       FontWeight="Bold"/>

                            <TextBlock Text="{Binding Statement.Commission,
                                              StringFormat={}{0:N2} kr.}"/>

                        </StackPanel>

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="Reol beløb: "
                                       FontWeight="Bold"/>

                            <TextBlock Text="{Binding Statement.RackAmount,
                                              StringFormat={}{0:N2} kr.}"/>

                        </StackPanel>

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="Saldo: "
                                       FontWeight="Bold"/>

                            <TextBlock Text="{Binding Statement.FinalAmount,
                                              StringFormat={}{0:N2} kr.}"/>

                        </StackPanel>

                    </StackPanel>

                </StackPanel>

            </Border>

        </ScrollViewer>

        <!-- BOGFØRINGSSTATUS -->

        <Border Grid.Row="2"
                BorderBrush="Black"
                BorderThickness="1"
                Margin="10"
                Padding="10">

            <TextBlock Text="{Binding PostedInfo}"
                       FontWeight="Bold"
                       HorizontalAlignment="Center">

                <TextBlock.Style>

                    <Style TargetType="TextBlock">

                        <Setter Property="Foreground"
                                Value="Red"/>

                        <Style.Triggers>

                            <DataTrigger Binding="{Binding IsMonthPosted}"
                                         Value="True">

                                <Setter Property="Foreground"
                                        Value="Green"/>

                            </DataTrigger>

                        </Style.Triggers>

                    </Style>

                </TextBlock.Style>

            </TextBlock>

        </Border>

    </Grid>

</UserControl>      
