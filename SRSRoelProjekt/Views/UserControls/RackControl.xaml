<UserControl x:Class="SRSRoelProjekt.Views.UserControls.RackControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SRSRoelProjekt.Views.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="210">
    
    <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
            </Grid.ColumnDefinitions>

            <!-- RowDefinitions must come before child elements -->
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="4*"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>

            
            
            <Button Grid.Row="1" Content="Tilføj Ny Lejer" FontWeight="Bold" Width="150" Height="30" Background="Lightgray" BorderBrush="Black" FontFamily="Cambria"/>
            <Button Grid.Row="2" Content="Fjern eksisterende Lejer" FontWeight="Bold" Width="150" Height="30" Background="Lightgray" BorderBrush="Black" FontFamily="Cambria"/>

            <TextBlock Grid.Row="3" Text="For at redigere,&#10;vælg en lejer i listen:" TextAlignment="Center" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" FontFamily="Cambria"/>

            <ComboBox x:Name="RenterComboBox" Width="190" Grid.Row="4" Height="30" VerticalAlignment="Top" FontWeight="Bold" FontFamily="Cambria" SelectionChanged="RenterComboBox_SelectionChanged">
                <ComboBox.ItemContainerStyle>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="Foreground" Value="Black"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="LightBlue"/>
                                <Setter Property="Foreground" Value="Blue"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ComboBox.ItemContainerStyle>

                <ComboBoxItem Content="Peter Jensen"/>
                <ComboBoxItem Content="Maria Hansen"/>
                <ComboBoxItem Content="Lars Nielsen"/>
            </ComboBox>

            <Button Grid.Row="4" Content="Stop Leje" Click="StopRental_Click" FontWeight="Bold" Width="150" Height="30" VerticalAlignment="Bottom" Background="Lightblue" BorderBrush="Blue" FontFamily="Cambria"/>
            <Button Grid.Row="5" Content="Gem Ændringer" Click="SaveShelf_Click" FontWeight="Bold" Width="150" Height="30" Background="Lightblue" BorderBrush="Blue" FontFamily="Cambria"/>
            
            
    </Grid>
</UserControl>
